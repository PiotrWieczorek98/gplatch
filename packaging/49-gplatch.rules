// Passwordless VPN control for the tray, limited to the exact commands it runs.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.policykit.exec" ||
        action.lookup("program") != "/usr/bin/gpclient" ||
        !subject.local || !subject.active || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    var command = action.lookup("command_line");
    var connect = /^\/usr\/bin\/gpclient( --fix-openssl)?( --ignore-tls-errors)? connect --cookie-on-stdin( --as-gateway)? [A-Za-z0-9][A-Za-z0-9.:-]*$/;
    if (connect.test(command) || command == "/usr/bin/gpclient disconnect") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
